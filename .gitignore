# AI 高解析度原始圖 (體積大，不納入版控；保留目錄結構)
raw_images/*
!raw_images/.gitkeep

# 轉檔產出卡圖 (本地快取，不納入版控；保留目錄結構)
dist/*
!dist/.gitkeep

# 本地圖鑑預覽頁面 (本地生成，不納入版控)
preview.html

# 備份檔與暫存檔
*.bak
*.tmp
*.swp
*~

# Python 快取與虛擬環境
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.env
*.egg-info/

# Node.js 依賴
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 作業系統與編輯器快取
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

